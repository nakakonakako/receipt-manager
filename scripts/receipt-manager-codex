#!/usr/bin/env bash
set -euo pipefail

die() {
  printf '[receipt-manager-codex] %s\n' "$1" >&2
  exit 2
}

checkout="${RECEIPT_MANAGER_CHECKOUT:-$HOME/web/receipt-manager}"
checkout="$(cd "$checkout" 2>/dev/null && pwd -P)" || die "Repository checkout not found: ${RECEIPT_MANAGER_CHECKOUT:-$HOME/web/receipt-manager}"
git -C "$checkout" rev-parse --show-toplevel >/dev/null 2>&1 || die "Not a Git checkout: $checkout"
[[ "$(git -C "$checkout" rev-parse --show-toplevel)" == "$checkout" ]] || die "Checkout path is not a repository root: $checkout"

if ! git -C "$checkout" fetch --quiet --no-tags origin refs/heads/main:refs/remotes/origin/main; then
  die "Could not fetch origin/main. Codex was not started; check network and remote access, then retry."
fi
baseline="$(git -C "$checkout" rev-parse --verify 'refs/remotes/origin/main^{commit}' 2>/dev/null)" \
  || die "Fetched origin/main is not a valid commit. Codex was not started."

session_id="${RECEIPT_MANAGER_SESSION_ID:-$(date -u +%Y%m%dT%H%M%S)-$$}"
[[ "$session_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "Invalid session identifier."
task="codex-session-$session_id"
branch="codex/$task"
worktree_root="$HOME/worktrees/receipt-manager"
workspace="$worktree_root/$task"
mkdir -p "$worktree_root" || die "Cannot create worktree parent: $worktree_root"

if [[ -e "$workspace" || -L "$workspace" ]]; then
  die "Worktree path already exists; nothing was reused or changed: $workspace"
fi
if git -C "$checkout" show-ref --verify --quiet "refs/heads/$branch"; then
  die "Session branch already exists; nothing was changed: $branch"
fi

if ! git -C "$checkout" worktree add -b "$branch" "$workspace" "$baseline"; then
  die "Could not create a fresh worktree from origin/main. Codex was not started."
fi
actual="$(git -C "$workspace" rev-parse HEAD 2>/dev/null)" || die "Cannot verify new worktree HEAD."
[[ "$actual" == "$baseline" ]] || die "New worktree does not match fetched origin/main; Codex was not started."
[[ -z "$(git -C "$workspace" status --porcelain=v1)" ]] || die "New worktree is not clean; Codex was not started."

printf '[receipt-manager-codex] baseline: origin/main %s\n' "$baseline" >&2
printf '[receipt-manager-codex] workspace: %s (%s)\n' "$workspace" "$branch" >&2
command -v codex >/dev/null 2>&1 || die "codex executable not found in PATH. The fresh worktree is preserved: $workspace"
exec codex -C "$workspace" "$@"
